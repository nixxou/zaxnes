<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Platform, graphics, audio, input (MIT) -->
  <ItemGroup>
    <PackageVersion Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.OpenGL.Extensions.ImGui" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Input" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.OpenAL" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
  </ItemGroup>

  <!-- UI -->
  <ItemGroup>
    <!--
      Pinned deliberately. Silk.NET.OpenGL.Extensions.ImGui 2.23.0 is compiled against
      ImGui.NET 1.90.8.1; the 1.91.x line changes Dear ImGui struct layouts and the
      controller would bind against a different native cimgui ABI. Raise both together.
    -->
    <PackageVersion Include="ImGui.NET" Version="1.90.8.1" />
  </ItemGroup>

  <!-- Formats and scripting -->
  <ItemGroup>
    <!-- No protobuf-net entry: the .3dn codec is hand-written (src/Zax.Profiles/Wire/, see the
         remark at the end of Zax.Profiles.csproj), so no protobuf library is referenced and
         none is shipped in the release (build/publish.ps1, THIRD-PARTY-NOTICES). -->
    <!-- Lua 5.4 native bindings (MIT). PLAN.md section 4: decision of 2026-10-20,
         KeraLua is required because 2 profiles use goto/labels (Lua >= 5.2). -->
    <PackageVersion Include="KeraLua" Version="1.4.11" />
  </ItemGroup>

  <!-- Test stack -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

</Project>
