<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Zax.Render\Zax.Render.csproj" />
  </ItemGroup>

  <!--
    The offscreen captures need a GL 3.3 core context. It is created through a hidden GLFW
    window; the tests that need one are skipped, not failed, when the machine cannot provide
    one (see GlFactAttribute).
  -->
  <ItemGroup>
    <PackageReference Include="Silk.NET.OpenGL" />
    <PackageReference Include="Silk.NET.Windowing" />
  </ItemGroup>

</Project>
