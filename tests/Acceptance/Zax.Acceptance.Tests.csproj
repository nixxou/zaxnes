<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>
      Reserved for the round-1 verifier (role R4), who is a different session from the
      implementers and writes acceptance tests from the specification alone. Implementers
      must not add tests here.
    </Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Zax.Nes\Zax.Nes.csproj" />
    <ProjectReference Include="..\..\src\Zax.Profiles\Zax.Profiles.csproj" />
    <ProjectReference Include="..\..\src\Zax.Engine3D\Zax.Engine3D.csproj" />
    <ProjectReference Include="..\..\src\Zax.Scripting\Zax.Scripting.csproj" />
    <ProjectReference Include="..\..\src\Zax.Settings\Zax.Settings.csproj" />
  </ItemGroup>

  <!--
    Part B (SPEC-06, SPEC-07, SPEC-11) needs the renderer, the desktop host and the platform
    layer. The host's loop is internal to Zax.App, which the verifier must not modify, so the
    loop is driven through reflection (see LoopDriver.cs).
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Zax.Render\Zax.Render.csproj" />
    <ProjectReference Include="..\..\src\Zax.App\Zax.App.csproj" />
    <ProjectReference Include="..\..\src\Zax.Platform\Zax.Platform.csproj" />
  </ItemGroup>

  <!--
    The offscreen captures of SPEC-06 need a GL 3.3 core context, obtained through a hidden
    GLFW window; tests that need one are skipped, not failed, when the machine has none.
  -->
  <ItemGroup>
    <PackageReference Include="Silk.NET.OpenGL" />
    <PackageReference Include="Silk.NET.Windowing" />
  </ItemGroup>

</Project>
