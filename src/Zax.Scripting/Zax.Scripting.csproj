<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Lua 5.4 runtime for profile scripts (SPEC-05). Platform-free library.</Description>
    <!-- KeraLua ships the native lua54 binaries under runtimes/&lt;rid&gt;/native. On a
         RID-less build the deps.json resolves win-x64 at run time; publishing uses the RID. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- The host objects of SPEC-05 §4.2 are Lua full userdata whose payload is read and
         written through pointers: that is what keeps a member access free of managed
         allocation (REQ-LUA-111). The unsafe code is confined to LuaBinder. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="KeraLua" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zax.Engine3D\Zax.Engine3D.csproj" />
    <ProjectReference Include="..\Zax.Nes\Zax.Nes.csproj" />
    <ProjectReference Include="..\Zax.Profiles\Zax.Profiles.csproj" />
    <ProjectReference Include="..\Zax.Settings\Zax.Settings.csproj" />
  </ItemGroup>

</Project>
