<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Zax.Harness</AssemblyName>
    <Description>Headless harness: drives the libraries with no visible window, and renders offscreen.</Description>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- Required by the GL interop of the offscreen target (null pixel pointers). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    The platform-free libraries. Zax.Platform and Zax.App are deliberately absent: the harness
    exists to prove the core runs without a window, which is also what a libretro frontend
    relies on (SPEC-01 REQ-ARCH-002).
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Zax.Nes\Zax.Nes.csproj" />
    <ProjectReference Include="..\..\src\Zax.Profiles\Zax.Profiles.csproj" />
    <ProjectReference Include="..\..\src\Zax.Engine3D\Zax.Engine3D.csproj" />
    <ProjectReference Include="..\..\src\Zax.Scripting\Zax.Scripting.csproj" />
  </ItemGroup>

  <!--
    The 'render' command of REQ-ARCH-031 has to produce an offscreen capture, which needs a GL
    3.3 core context. It is created through a *hidden* window and is never shown, so the
    'meshes' command and the rest stay usable on a machine without a display server.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Zax.Render\Zax.Render.csproj" />
    <PackageReference Include="Silk.NET.OpenGL" />
    <PackageReference Include="Silk.NET.Windowing" />
  </ItemGroup>

  <!-- The render tests drive the very scenes and the very offscreen target this tool uses. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Zax.Render.Tests" />
  </ItemGroup>

</Project>
